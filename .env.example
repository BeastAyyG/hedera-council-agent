# Copy to .env and fill in. Never commit a real .env.
# Hedera testnet, from portal.hedera.com (Testnet, 1000 test HBAR)
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.
HEDERA_PRIVATE_KEY=
# Optional: HCS topic for the audit log. Leave blank to create one on first run (real mode only).
HEDERA_TOPIC_ID=
# x402 check price, in tinybars, for the internal HBAR check fee (simulated / self-run shape)
X402_CHECK_PRICE_TINYBARS=100000
# Real x402 route (POST /check): $0.01 in Hedera testnet USDC 0.0.429274,
# via the Official facilitator https://x402.org/facilitator.
# The paying account must be associated with testnet USDC (faucet.circle.com).
X402_FACILITATOR_URL=https://x402.org/facilitator
# Spending cap for the agent, in tinybars, per demo run
AGENT_SPEND_CAP_TINYBARS=1000000
# Large proposal threshold, in tinybars. At or above this, World ID is required.
LARGE_PROPOSAL_TINYBARS=50000000
# 0G Private Computer (OpenAI-compatible). Get credits/key from the 0G booth / pc.0g.ai (wallet login, Dashboard, API Keys, sk- key).
ZERO_G_API_KEY=
ZERO_G_BASE_URL=https://router-api.0g.ai/v1
ZERO_G_MODEL=0gm-1.0-35b-a3b
# World ID Agent Pass / IDKit 4.x. No standalone Agent Pass SDK exists;
# the official flow is human-in-the-loop / IDKit, backend verification at
# POST https://developer.world.org/api/v4/verify/{WORLD_RP_ID}.
# Get rp_id, app_id and the signing key from developer.world.org.
# Proofs are mocked by World for this event; no sandbox app needed.
# Never expose WORLD_SIGNING_KEY to the client.
WORLD_RP_ID=
WORLD_APP_ID=
WORLD_SIGNING_KEY=
