# Copy to .env and fill in. Never commit a real .env.
# `npm run preflight` checks all of this; `-- --setup` does the one-time Hedera setup.

# Hedera testnet, from portal.hedera.com (Testnet, ECDSA account, 1000 test HBAR)
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# Raw hex keys are read as ECDSA (needed for x402). Set ed25519 only for a raw ED25519 key.
# HEDERA_KEY_TYPE=
# Account the proposals pay out of. `npm run preflight -- --create-council` creates a 2-of-2
# treasury (agent + a council member) and saves it with the member's key to .data/council.json.
HEDERA_TREASURY_ACCOUNT_ID=
# The council member that schedules proposals (default: from .data/council.json).
# COUNCIL_PROPOSER_ACCOUNT_ID=
# COUNCIL_PROPOSER_PRIVATE_KEY=
# HCS audit topic. Leave blank: one is created on first audit and its id is printed.
HEDERA_TOPIC_ID=
# Public key that administers the audit topic (held by the council, not the agent).
# The agent's own key is the submit key: it can append, but cannot rewrite history.
# Leave blank: the topic is created with no admin key, so nobody can delete or update it.
# HEDERA_TOPIC_ADMIN_KEY=

# x402. POST /check costs $0.01 in Hedera testnet USDC 0.0.429274, via the Official facilitator.
# Both the agent and X402_PAY_TO must be associated with testnet USDC (faucet.circle.com).
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PRICE_USDC=0.01
# Fee account that receives check fees. Create one: npm run preflight -- --create-fee-account
X402_PAY_TO=
# Paid check service the agent calls (default: this server's /check)
CHECK_SERVICE_URL=
# Agent spending cap per run, in USDC
AGENT_SPEND_CAP_USDC=0.10
# Large proposal threshold, in tinybars. At or above this, World ID is required.
LARGE_PROPOSAL_TINYBARS=50000000

# 0G Private Computer (OpenAI-compatible). Key from pc.0g.ai (wallet login, Dashboard, API Keys, sk- key).
ZERO_G_API_KEY=
ZERO_G_BASE_URL=https://router-api.0g.ai/v1
ZERO_G_MODEL=0gm-1.0-35b-a3b

# Fail closed: no 0G verdict (call failed, or no key in real mode), no signature.
# ALLOW_NO_0G=true lets the agent sign anyway; the log entry says so.
ALLOW_NO_0G=

# Council payee registry (this project's own list, not ERC-8004/8478). JSON array or comma list of 0.0.x.
# Non-empty enforces it: a proposal paying an unregistered or expired account is refused.
PAYEE_REGISTRY=
PAYEE_REGISTRY_FILE=
REQUIRE_REGISTERED_PAYEE=

# Challenge window: 0 (default) signs as soon as every check passes. Above 0 a passing proposal
# waits that many seconds, then POST /proposals/:id/execute re-checks everything before it signs.
CHALLENGE_WINDOW_SECONDS=

# API key for the state-changing routes (Bearer or x-api-key). Unset: routes are open (demo only).
COUNCIL_API_KEY=

# World ID 4.0 / IDKit 4.x. rp_id, app_id and signing key from developer.world.org.
# All three set = real verification, mocked approvals refused. Never expose WORLD_SIGNING_KEY.
WORLD_RP_ID=
WORLD_APP_ID=
WORLD_SIGNING_KEY=
# production (default), staging or sandbox. Server-side only; clients cannot choose.
WORLD_ENVIRONMENT=production

# Council seats and spent World approvals (default .data/state.json)
# STATE_FILE=
