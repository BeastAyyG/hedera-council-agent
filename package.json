{
  "dependencies": {
    "@hiero-ledger/proto": "^2.32.0",
    "@hiero-ledger/sdk": "^2.90.0",
    "@worldcoin/idkit-core": "^4.6.0",
    "@x402/core": "^2.30.0",
    "@x402/express": "^2.30.0",
    "@x402/extensions": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "@x402/hedera": "^2.30.0",
    "express": "^5.0.0",
    "qrcode": "^1.5.4"
  },
  "description": "AI agent with one signing seat on a Hedera treasury council. Paid proposal checks via x402, Scheduled Transactions plus HCS, no smart contracts, World ID gate for large signings, 0G Private Computer verdicts.",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.12"
  },
  "name": "hedera-council-agent",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "npm run build && node --import ./dist/src/env.js dist/src/demo.js",
    "preflight": "npm run build && node --import ./dist/src/env.js dist/src/preflight.js",
    "ready": "npm run build --silent && node --import ./dist/src/env.js dist/src/ready.js",
    "start": "node --import ./dist/src/env.js dist/src/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify": "npm run build --silent && node --import ./dist/src/env.js dist/src/verify.js",
    "propose": "npm run build --silent && node --import ./dist/src/env.js dist/src/propose.js",
    "css:console": "tailwindcss -i design/console-entry.css -o public/assets/console-original.css --minify",
    "console:install": "npm --prefix original-console install --ignore-scripts && npm --prefix original-console/console install --ignore-scripts",
    "console": "npm --prefix original-console/console run build && npm --prefix original-console/console run start -- -p 3380"
  },
  "type": "module",
  "version": "0.1.0"
}
